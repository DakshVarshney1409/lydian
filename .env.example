# Which model judges the traces. See providers.py for details.
# Provider: anthropic | openai  (openai also covers any OpenAI-compatible endpoint)
LYDIAN_PROVIDER=anthropic

# Model name. Required for openai; anthropic defaults to claude-sonnet-5.
# LYDIAN_JUDGE_MODEL=

# Optional reasoning effort, e.g. high.
# LYDIAN_JUDGE_EFFORT=

# Optional OpenAI-compatible endpoint, e.g. a local server: http://localhost:11434/v1
# LYDIAN_BASE_URL=

# Only the key for your provider is needed. A local server needs none.
ANTHROPIC_API_KEY=REPLACE_ME
# OPENAI_API_KEY=REPLACE_ME
